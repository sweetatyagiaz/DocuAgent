# Dockerfile.backend — FastAPI backend service
FROM python:3.12-slim

WORKDIR /app

# System deps for building some Python packages (kept minimal for image size)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY data/ ./data/

# Regenerate the demo SQLite DB at build time rather than relying on a
# binary file being committed to source control — keeps the image
# reproducible from source.
RUN python -m app.db.init_db

# Persisted vector store lives here — mount a volume in docker-compose.yml
# so ingested documents survive container restarts.
RUN mkdir -p /app/chroma_db

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
